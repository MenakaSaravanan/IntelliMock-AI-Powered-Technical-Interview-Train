# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# IBM Cloud API key — https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here

# watsonx.ai project ID — found in your watsonx project settings
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# watsonx.ai regional endpoint (default: us-south)
# Other regions: eu-de, eu-gb, jp-tok, au-syd
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# (Optional) Port for the Flask dev server
PORT=5000
